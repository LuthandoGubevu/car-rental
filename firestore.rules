rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Signup writes its own doc; role is fixed at 'customer' client-side and
      // never accepted as a field a client can change afterwards.
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'customer';
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role;
      allow update: if isAdmin();
    }

    match /vehicles/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.driverUid == request.auth.uid);
      allow create, delete: if isAdmin();
      // A driver submitting a condition check stamps their own vehicle's
      // lastInspectionAt - allowed, but only that one field, so they can't
      // touch status, reg, or reassign the vehicle to a different driver.
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.driverUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastInspectionAt']));
    }

    match /submissions/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.driverUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.driverUid == request.auth.uid &&
        request.resource.data.status == 'Awaiting Review';
      // Only the review verdict fields change after creation, and only an
      // admin can move a submission out of Awaiting Review.
      allow update: if isAdmin();
    }

    match /incidents/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.driverUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.driverUid == request.auth.uid;
      allow update: if isAdmin();
    }

    // Submitted from the public landing page - the one collection with no
    // isSignedIn() requirement, since a prospect filling this in was never
    // asked to create an account. status is pinned to 'New' so a request
    // can't arrive pre-marked as handled.
    match /demoRequests/{id} {
      allow read, update: if isAdmin();
      allow create: if request.resource.data.status == 'New' &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.company is string && request.resource.data.company.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0;
    }
  }
}
