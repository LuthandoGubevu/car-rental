rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Firestore caches repeated get()s to the same path within one rule
    // evaluation, so calling this from several helpers below costs one
    // document read, not several.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? me().role : null;
    }

    function myCompanyId() {
      return isSignedIn() ? me().companyId : null;
    }

    function isStaff() {
      return isSignedIn() && myRole() == 'staff';
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isAdminOfCompany(companyId) {
      return isAdmin() && myCompanyId() == companyId;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isStaff() ||
        (isAdmin() && resource.data.companyId == myCompanyId())
      );

      // The ONLY way to create a users doc: consuming a valid, matching,
      // still-pending invite (never 'staff' - that role is provisioned by
      // hand, never through this app).
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role in ['admin', 'driver'] &&
        request.resource.data.companyId is string &&
        request.resource.data.inviteId is string &&
        exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)) &&
        get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.status == 'pending' &&
        get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.companyId == request.resource.data.companyId &&
        get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role &&
        get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.email.lower() == request.auth.token.email.lower();

      // Self-update: never touch role or companyId.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.companyId == resource.data.companyId;

      // Staff can manage any account (support, corrections, promotions).
      allow update: if isStaff();

      // Checking moved in-house: role changes are staff-only now (via the
      // isStaff() branch above). The one thing an admin keeps here is an
      // internal note on one of their own drivers.
      allow update: if isAdminOfCompany(resource.data.companyId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminNote']);
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (isStaff() || myCompanyId() == companyId);

      allow create: if isStaff() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() > 0;

      allow update: if isStaff() ||
        (isAdminOfCompany(companyId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['contactName', 'contactEmail', 'contactPhone', 'address', 'branches']));

      allow delete: if false; // suspend via status, never hard-delete.
    }

    match /invites/{inviteId} {
      // Anyone holding the (effectively unguessable) invite link needs to
      // fetch this exact doc pre-auth to render the accept-invite page.
      // Listing the whole collection is NOT public - that would let it be
      // enumerated - so list is scoped like every other collection.
      allow get: if true;
      allow list: if isStaff();

      // Checking moved in-house: staff invites both a client's admins and
      // its drivers now, so this is the only create branch left.
      allow create: if isStaff() &&
        request.resource.data.role in ['admin', 'driver'] &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)) &&
        request.resource.data.companyName == get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.name &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdBy == request.auth.uid;

      // Revoke: staff only now (an admin no longer manages invites).
      // Accept: the invitee themselves, exactly once.
      allow update: if
        (isStaff() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'revoked')
        ||
        (isSignedIn() &&
          resource.data.status == 'pending' &&
          resource.data.email.lower() == request.auth.token.email.lower() &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']));

      allow delete: if isStaff();
    }

    match /vehicles/{id} {
      allow read: if isSignedIn() && (
        isStaff() ||
        (isAdmin() && resource.data.companyId == myCompanyId()) ||
        resource.data.driverUid == request.auth.uid
      );

      // Checking moved in-house: onboarding a vehicle is staff's job now.
      allow create: if isStaff() &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId));

      allow delete: if isStaff();

      // Staff has full write power (companyId immutable); the client admin
      // keeps exactly one field - an internal note - and a driver
      // submitting a condition check stamps their own vehicle's
      // lastInspectionAt, and only that one field, so they can't touch
      // status, reg, or reassign the vehicle to a different driver.
      allow update: if
        (isStaff() && request.resource.data.companyId == resource.data.companyId) ||
        (isAdminOfCompany(resource.data.companyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminNote'])) ||
        (isSignedIn() && resource.data.driverUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastInspectionAt']));
    }

    match /submissions/{id} {
      allow read: if isSignedIn() && (
        isStaff() ||
        (isAdmin() && resource.data.companyId == myCompanyId()) ||
        resource.data.driverUid == request.auth.uid
      );

      allow create: if isSignedIn() &&
        request.resource.data.driverUid == request.auth.uid &&
        request.resource.data.companyId == myCompanyId() &&
        request.resource.data.status == 'Awaiting Review';

      // Checking moved in-house: only staff can move a submission out of
      // Awaiting Review. The client admin keeps one light action - marking
      // a flagged submission as seen, without changing its verdict.
      allow update: if
        (isStaff() && request.resource.data.companyId == resource.data.companyId) ||
        (isAdminOfCompany(resource.data.companyId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acknowledgedByAdmin', 'acknowledgedAt', 'acknowledgedBy', 'acknowledgedByUid']));
    }

    match /incidents/{id} {
      allow read: if isSignedIn() && (
        isStaff() ||
        (isAdmin() && resource.data.companyId == myCompanyId()) ||
        resource.data.driverUid == request.auth.uid
      );

      allow create: if isSignedIn() &&
        request.resource.data.driverUid == request.auth.uid &&
        request.resource.data.companyId == myCompanyId();

      // Checking moved in-house: only staff resolves an incident. The
      // client admin keeps one light action - acknowledging it.
      allow update: if
        (isStaff() && request.resource.data.companyId == resource.data.companyId) ||
        (isAdminOfCompany(resource.data.companyId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acknowledgedByAdmin', 'acknowledgedAt', 'acknowledgedBy', 'acknowledgedByUid']));
    }

    // Submitted from the public landing page - the one collection with no
    // isSignedIn() requirement, since a prospect filling this in was never
    // asked to create an account. status is pinned to 'New' so a request
    // can't arrive pre-marked as handled. These are FleetCare's own leads,
    // not scoped to any fleet company, so only staff can read/manage them.
    match /demoRequests/{id} {
      allow read, update: if isStaff();
      allow create: if request.resource.data.status == 'New' &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.company is string && request.resource.data.company.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0;
    }
  }
}
