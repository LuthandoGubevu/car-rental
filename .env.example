# Copy this file to .env for local `netlify dev` testing. Never commit the
# real .env - it's already gitignored. These are used only by the Netlify
# Functions in netlify/functions/, never by the Vite frontend.

# Paystack Dashboard -> Settings -> API Keys & Webhooks. Start with the
# test key (sk_test_...) and only switch to the live key (sk_live_...)
# once the full flow has been proven end to end in test mode.
PAYSTACK_SECRET_KEY=

# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Paste the entire downloaded JSON file as one line here.
FIREBASE_SERVICE_ACCOUNT_JSON=
