rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && myProfile().role == 'staff';
    }

    function ownerCompanyId(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data.companyId;
    }

    function isAdminOfOwnerCompany(uid) {
      return isSignedIn() && myProfile().role == 'admin' && myProfile().companyId == ownerCompanyId(uid);
    }

    match /submissions/{uid}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff() || isAdminOfOwnerCompany(uid));
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
